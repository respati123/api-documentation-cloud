# Docker Compose local development. Copy to .env and change the password for any shared environment.
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=55433
API_PORT=3001
CLOUD_WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
# Browser origins allowed to call the API, comma separated. Leave empty when the web portal is served from the same origin.
# Add null for the desktop app, which loads its pages from file:// and sends the origin null.
CORS_ORIGINS=
LOG_LEVEL=info
APP_VERSION=dev

# Invitation email (Mailpit locally)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=API Documentation <no-reply@example.test>
# When the API runs on the host (bun run api:dev) and Mailpit runs in Docker, point SMTP at the Mailpit port published on 127.0.0.1.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=11025
# MAILPIT_SMTP_PORT=11025
