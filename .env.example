# Docker Compose local development. Copy to .env and change the password for any shared environment.
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=55433
API_PORT=3001
CLOUD_WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
# Browser origins allowed to call the API, comma separated. Leave empty when the web portal is served from the same origin.
# Add null for the desktop app, which loads its pages from file:// and sends the origin null.
CORS_ORIGINS=
LOG_LEVEL=info
APP_VERSION=dev

# When the API runs on the host (bun run api:dev). Keep the password and port in step with the values above.
DATABASE_URL=postgres://apidocs:local-dev-only@127.0.0.1:55433/apidocs
# The web portal from bun run cloud:dev runs on port 5174.
# PUBLIC_WEB_URL=http://localhost:5174

# Invitation email (Mailpit locally)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=API Documentation <no-reply@example.test>
# When the API runs on the host (bun run api:dev) and Mailpit runs in Docker, point SMTP at the Mailpit port published on 127.0.0.1.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=11025
# MAILPIT_SMTP_PORT=11025

# App admin, created by `bun run api:seed-admin`. Use a real address and a strong password in your own .env.
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=change-me-to-a-long-password

# OpenID Connect (sign-in for DBDesign and Stitchkit). Leave both empty to turn it off.
# Create the key once: see PLAN-sso-oidc.md, Task 0.1. Never commit the real value.
OIDC_SIGNING_KEY_B64=
OIDC_SIGNING_KEY_ID=

# DBDesign and Stitchkit, reached by the portal for the Design pages, story pickers, and MCP tools.
# Leave empty to turn an app off. Both need the OIDC key above.
DBDESIGN_URL=
STITCHKIT_URL=
