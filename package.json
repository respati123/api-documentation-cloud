{
  "name": "api-documentation-cloud",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "cloud:dev": "cd web && bun run dev",
    "cloud:build": "cd web && bun run build",
    "cloud:typecheck": "cd web && bun run typecheck",
    "api:dev": "bun --cwd server --watch src/index.ts",
    "api:start": "bun --cwd server src/index.ts",
    "api:typecheck": "cd server && bun run typecheck",
    "api:test": "bun test server",
    "cloud:test": "cd web && bun run test",
    "cloud:i18n-check": "cd web && bun run i18n-check",
    "cloud:lint": "cd web && bun run lint",
    "cloud:format": "cd web && bun run format"
  }
}
